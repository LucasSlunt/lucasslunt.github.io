<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ apple.name }} | Apples I Have Eaten</title>
	<link rel="stylesheet" href="../../pageElementFiles/css/navbar.css">
	<link rel="stylesheet" href="../apples.css">
	<link rel="stylesheet" href="../apple-page.css?v=description-breaks">
	<link rel="icon" type="image/x-icon" href="../../pageElementFiles/icon.png">
	<script src="../../pageElementFiles/scripts/navBar.js"></script>
</head>

<body onload="setupNavbar('../../', '#cee89d', '#e6f8bf')">
	<main class="apple-page" aria-labelledby="apple-title">
		<a class="back-link" href="../index.html">&larr; Back to all apples</a>

		<section class="apple-page-content">
			<div class="apple-page-image-frame">
				<img class="apple-page-image" src="../ApplePictures/AllApples/{{ apple.id }}.jpg" alt="{{ apple.name }}" loading="eager">
			</div>

			<div class="apple-page-details">
				<header class="apple-page-header">
					<h1 id="apple-title">{{ apple.name }}</h1>
				</header>

				<section class="rating-box" aria-labelledby="rating-heading">
					<div class="rating-box-header">
						<h2 id="rating-heading">{{ apple.rating }} / 10</h2>
						<div class="stars" aria-label="{{ apple.rating }} out of 10 rating">
							<span aria-hidden="true">☆ ☆ ☆ ☆ ☆</span>
						</div>
					</div>
					{% set sweetness_groups = [['Not sweet'], ['Mildly sweet', 'Barely sweet'], ['Fairly sweet'], ['Sweet'], ['Very sweet'], ['Incredibly sweet']] %}
					{% set sourness_groups = [['Not sour'], ['Barely sour', 'Barely tart', 'Mildly sour', 'Mildly tart'], ['Slightly sour', 'Slightly tart'], ['Spritely'], ['Tart'], ['Sour', 'Quite tart', 'Quite sour'], ['Very sour']] %}
					{% set juiciness_groups = [['Very dry'], ['Dry'], ['Slightly dry'], ['Fairly juicy'], ['Moderate'], ['Juicy', 'Watery'], ['Very juicy'], ['Ridiculously juicy']] %}
					{% set texture_groups = [['Muddy', 'Rubbery'], ['Mealy'], ['Very soft'], ['Soft'], ['Fairly soft'], ['Fairly crisp', 'Slightly crisp'], ['Crisp'], ['Very crisp', 'Hard'], ['Crunchy', 'Dense'], ['Very crunchy']] %}
					{% set size_groups = [['Toonie'], ['Golf ball'], ['Fist'], ['Baseball'], ['Softball'], ['Humungous']] %}
					<div class="apple-attributes">
						<dl>
							<div>
								<dt><span class="sr-only">Sweetness: </span>{{ apple.sweetness }}</dt>
								<dd><span class="rating-bar" role="img" aria-label="Sweetness: {{ apple.sweetness }}" style="--rating-steps: {{ sweetness_groups|length }}"><span class="rating-bar-track">{% for group in sweetness_groups %}<span class="rating-dot{% if apple.sweetness in group %} is-active{% endif %}"></span>{% endfor %}</span></span></dd>
							</div>
							<div>
								<dt><span class="sr-only">Sourness: </span>{{ apple.sourness }}</dt>
								<dd><span class="rating-bar" role="img" aria-label="Sourness: {{ apple.sourness }}" style="--rating-steps: {{ sourness_groups|length }}"><span class="rating-bar-track">{% for group in sourness_groups %}<span class="rating-dot{% if apple.sourness in group %} is-active{% endif %}"></span>{% endfor %}</span></span></dd>
							</div>
							<div>
								<dt><span class="sr-only">Juiciness: </span>{{ apple.juiciness }}</dt>
								<dd><span class="rating-bar" role="img" aria-label="Juiciness: {{ apple.juiciness }}" style="--rating-steps: {{ juiciness_groups|length }}"><span class="rating-bar-track">{% for group in juiciness_groups %}<span class="rating-dot{% if apple.juiciness in group %} is-active{% endif %}"></span>{% endfor %}</span></span></dd>
							</div>
							<div>
								<dt><span class="sr-only">Texture: </span>{{ apple.texture }}</dt>
								<dd><span class="rating-bar" role="img" aria-label="Texture: {{ apple.texture }}" style="--rating-steps: {{ texture_groups|length }}"><span class="rating-bar-track">{% for group in texture_groups %}<span class="rating-dot{% for option in group %}{% if apple.texture == option or apple.texture.startswith(option ~ ',') %} is-active{% endif %}{% endfor %}"></span>{% endfor %}</span></span></dd>
							</div>
							<div>
								<dt><span class="sr-only">Size: </span>{{ apple.size }}</dt>
								<dd><span class="rating-bar" role="img" aria-label="Size: {{ apple.size }}" style="--rating-steps: {{ size_groups|length }}"><span class="rating-bar-track">{% for group in size_groups %}<span class="rating-dot{% if apple.size in group %} is-active{% endif %}"></span>{% endfor %}</span></span></dd>
							</div>
						</dl>
					</div>
				</section>

				<section class="description-box" aria-labelledby="description-heading">
					<h2 id="description-heading">Description</h2>
					<p class="apple-description">{{ apple.description }}</p>
				</section>

				<dl class="apple-metadata">
					<div><dt>Date documented</dt><dd>{{ apple.dateDocumented }}</dd></div>
					<div><dt>Acquired from</dt><dd>{{ apple.acquiredFrom }}</dd></div>
				</dl>
			</div>
		</section>
	</main>
</body>
</html>