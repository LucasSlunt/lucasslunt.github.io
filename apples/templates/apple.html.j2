<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ apple.name }} | Apples I Have Eaten</title>
	<link rel="stylesheet" href="../../pageElementFiles/css/navbar.css">
	<link rel="stylesheet" href="../apples.css">
	<link rel="stylesheet" href="../apple-page.css?v=description-breaks">
	<link rel="icon" type="image/x-icon" href="../../pageElementFiles/icon.png">
	<script src="../../pageElementFiles/scripts/navBar.js"></script>
</head>

<body onload="setupNavbar('../../', '#cee89d', '#e6f8bf')">
	<main class="apple-page" aria-labelledby="apple-title">
		<a class="back-link" href="../index.html">&larr; Back to all apples</a>

		<section class="apple-page-content">
			<div class="apple-page-visual">
				<div class="apple-page-image-frame">
					<img class="apple-page-image" src="../ApplePictures/AllApples/{{ apple.id }}.jpg" alt="{{ apple.name }}" loading="eager">
				</div>

				<section class="rating-box" aria-labelledby="rating-heading">

					<div class="rating-box-header">
						<h2 id="rating-heading">{{ apple.rating }} / 10</h2>
						<div class="stars" aria-label="{{ apple.rating }} out of 10 rating">
							<span aria-hidden="true">☆ ☆ ☆ ☆ ☆</span>
						</div>
					</div>
					{% set sweetness_groups = [['Not sweet'], ['Mildly sweet', 'Barely sweet'], ['Fairly sweet'], ['Sweet'], ['Very sweet'], ['Incredibly sweet']] %}
					{% set sourness_groups = [['Not sour'], ['Barely sour', 'Barely tart', 'Mildly sour', 'Mildly tart'], ['Slightly sour', 'Slightly tart'], ['Spritely'], ['Tart'], ['Sour', 'Quite tart', 'Quite sour'], ['Very sour']] %}
					{% set juiciness_groups = [['Very dry'], ['Dry'], ['Slightly dry'], ['Fairly juicy'], ['Moderate'], ['Juicy', 'Watery'], ['Very juicy'], ['Ridiculously juicy']] %}
					{% set texture_groups = [['Muddy', 'Rubbery'], ['Mealy'], ['Very soft'], ['Soft'], ['Fairly soft'], ['Fairly crisp', 'Slightly crisp'], ['Crisp'], ['Very crisp', 'Hard'], ['Crunchy', 'Dense'], ['Very crunchy']] %}
					{% set size_groups = [['Toonie'], ['Golf ball'], ['Fist'], ['Baseball'], ['Softball'], ['Humungous']] %}
					{% macro rating_markers(groups, value, match_prefix=false) %}
						{% for group in groups %}
							{% set matching = namespace(found=value in group) %}
							{% if match_prefix %}
								{% set matching.found = false %}
								{% for option in group %}{% if value == option or value.startswith(option ~ ',') %}{% set matching.found = true %}{% endif %}{% endfor %}
							{% endif %}
							<span class="rating-dot{% if matching.found %} is-active{% if loop.index0 == 0 %} is-low is-extreme{% elif loop.index0 == groups|length - 1 %} is-high is-extreme{% elif loop.index0 < groups|length / 3 %} is-low{% elif loop.index0 >= groups|length - groups|length / 3 %} is-high{% else %} is-middle{% endif %}{% endif %}" style="--rating-index: {{ loop.index0 }}"></span>
						{% endfor %}
					{% endmacro %}
					<div class="apple-attributes">
						<dl>
							<div>
								<dt><span class="sr-only">Sweetness: </span>{{ apple.sweetness }}</dt>
								<dd><span class="rating-bar" role="img" aria-label="Sweetness: {{ apple.sweetness }}" style="--rating-steps: {{ sweetness_groups|length }}"><span class="rating-bar-track">{{ rating_markers(sweetness_groups, apple.sweetness) }}</span></span></dd>
							</div>
							<div>
								<dt><span class="sr-only">Sourness: </span>{{ apple.sourness }}</dt>
								<dd><span class="rating-bar" role="img" aria-label="Sourness: {{ apple.sourness }}" style="--rating-steps: {{ sourness_groups|length }}"><span class="rating-bar-track">{{ rating_markers(sourness_groups, apple.sourness) }}</span></span></dd>
							</div>
							<div>
								<dt><span class="sr-only">Juiciness: </span>{{ apple.juiciness }}</dt>
								<dd><span class="rating-bar" role="img" aria-label="Juiciness: {{ apple.juiciness }}" style="--rating-steps: {{ juiciness_groups|length }}"><span class="rating-bar-track">{{ rating_markers(juiciness_groups, apple.juiciness) }}</span></span></dd>
							</div>
							<div>
								<dt><span class="sr-only">Texture: </span>{{ apple.texture }}</dt>
								<dd><span class="rating-bar" role="img" aria-label="Texture: {{ apple.texture }}" style="--rating-steps: {{ texture_groups|length }}"><span class="rating-bar-track">{{ rating_markers(texture_groups, apple.texture, true) }}</span></span></dd>
							</div>
							<div>
								<dt><span class="sr-only">Size: </span>{{ apple.size }} sized</dt>
								<dd><span class="rating-bar" role="img" aria-label="Size: {{ apple.size }} sized" style="--rating-steps: {{ size_groups|length }}"><span class="rating-bar-track">{{ rating_markers(size_groups, apple.size) }}</span></span></dd>
							</div>
						</dl>
					</div>
				</section>
			</div>

			<div class="apple-page-details">
				<header class="apple-page-header">
					<h1 id="apple-title">{{ apple.name }}</h1>
				</header>

				<section class="description-box" aria-labelledby="description-heading">
					<h2 id="description-heading">Description</h2>
					<p class="apple-description">{{ apple.description }}</p>
					<dl class="apple-metadata">
						<div><dt>Acquired from</dt><dd>{{ apple.acquiredFrom }}</dd></div>
						<div><dt>Date documented</dt><dd>{{ apple.dateDocumented }}</dd></div>
					</dl>
				</section>

				<section class="similar-apples" aria-labelledby="similar-apples-heading">
					<h2 id="similar-apples-heading">Similar apples</h2>
					<ul>
						{% for similar in apple.similar_apples %}
						<li class="similar-apple-item">
							<a class="similar-apple-link" href="{{ similar.id }}.html">
								<img src="../ApplePictures/AllApples/{{ similar.id }}.jpg" alt="{{ similar.name }}">
								<span>{{ similar.name }} {{ similar.comparison }}.</span>
							</a>
						</li>
						{% endfor %}
					</ul>
				</section>
			</div>
		</section>
	</main>
</body>
</html>